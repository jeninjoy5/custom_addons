<?xml version="1.0" encoding="utf-8"?>


<odoo>

   <record id="res_config_settings_view_form_inherit_purchase" model="ir.ui.view">
       <field name="name">res.config.settings.view.form.inherit.purchase</field>
       <field name="model">res.config.settings</field>
       <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
       <field name="arch" type="xml">
           <xpath expr="//app[@name='purchase']" position="inside">
               <block title="Attachments">
                   <setting string="Require Attachment on Purchase Order
                   Confirmation" help="Ensure that a purchase order cannot be
                   confirmed unless at least one valid attachment is added">
                       <field name="is_require_attachment"/>
                   </setting>
               </block>
           </xpath>
       </field>
   </record>

</odoo>