<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_service_close" model="mail.template">
           <field name="name">Service Close</field>
           <field name="model_id" ref="machine_management.model_machine_service"/>
           <field name="subject">{{ object.company_id.name }}</field>
           <field name="email_from">{{ (object.company_id.email_formatted) }}</field>
           <field name="description">Send to the customer when service is closed</field>
           <field name="body_html" type="html">
               <div>
                   <p>
                       Hello,
                       <br/>
                       <br/>
                        Service for your machine is completed
                       <br/>
                       <br/>
                       <br/><t t-out="object.company_id.name">Company</t>
                       <br/>
                       <br/>
                   </p>
               </div>
           </field>
       </record>
    </data>
</odoo>