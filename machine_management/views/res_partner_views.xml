<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="action_customer_view" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_group_customers":1}</field>

<!--        <field name="domain">[('is_customer','=',True)]</field>-->
    </record>   


    <record id="res_partner_view_machine_buttons" model="ir.ui.view">
        <field name="name">res.partner.view.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="3"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_view_machines"
                    icon="fa-wrench">
                    <field string="Machines" name="machine_count"
                           widget="statinfo"/>
                </button>
            </div>
<!--            <xpath expr="//field[@name='category_id']" position="after">-->
<!--                <field name="product_ids" widget="many2many_avatar_user"/>-->
<!--                <field name="test_count"/>-->
<!--            </xpath>-->
<!--            <xpath expr="//field[@name='category_id']" position="after">-->
<!--                <field name="is_customer"/>-->
<!--            </xpath>-->
        </field>
    </record>

    <record id="res_partner_view_search_machine" model="ir.ui.view">
            <field name="name">res.partner.search.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="before">
                   <filter string="Customers" name="group_customers" domain="[('is_customer','=',True)]"/>
                </xpath>
            </field>
        </record>
</odoo>