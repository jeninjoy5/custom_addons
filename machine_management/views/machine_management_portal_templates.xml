<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="machine_portal_layout" name="Portal Layout: MachineDetails"
              inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name=='machine_details_tree'"
                class="breadcrumb-item active">
            <span>Machines</span>
            </li>
            <li t-if="page_name=='machine_details_page'"
                class="breadcrumb-item active">
                <a t-attf-href="/machine">Machines</a> / <t t-esc="machine.machine_name"/>
            </li>
        </xpath>
    </template>


    <template id="portal_my_home_machine" name="Machine" customize_show="True" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/machine_management/static/src/img/machine1.svg'"/>
                <t t-set="title">Machines</t>
                <t t-set="url" t-value="'/machine'"/>
                <t t-set="text">View your machines</t>
                <t t-set="placeholder_count" t-value="'portal_machine'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_home_machine_views" name="My Machines">
        <t t-call="portal.portal_layout">
        <t t-set="breadcrumbs_searchbar" t-value="True"/>
        <t t-call="portal.portal_searchbar">
            <t t-set="title">Machine</t>
        </t>
        <t t-call="portal.portal_table">
        <thead>
            <tr class="active">
                <th class="text-left">Machine Name</th>
                <th class="text-center">Serial Number</th>
                <th class="text-center">Purchase Value</th>
                <th class="text-end">Status</th>
            </tr>
        </thead>
             <t t-foreach="machines" t-as="record">
                    <tr>
                        <td class='text-left'>
                            <a t-attf-href="/machine/#{record.id}">
                            <span t-field="record.machine_name"/>
                            </a>
                        </td>
                        <td class='text-center'>
                            <span t-field="record.serial_number"/>
                        </td>
                        <td class='text-center'>
                            <span t-field="record.purchase_value"/>
                        </td>
                        <td class='text-end'>
                            <span t-field="record.state"/>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_machine" name="My Project">
        <t t-call="portal.portal_layout">
            <style>
                td{
                font-size:20px;
                }
                p1{
                font-size:30px;
                }

            </style>
            <center>

                <div class="card">
                    <div class="card-header">
                        <p1>
                            <strong>Machine Details</strong>
                        </p1>
                    </div>
                    <div class="card-body">


                        <img t-att-src="'/web/image/machine.management/%s/image'%machine.id"
                             style="height:300px; width:300px; object-fit:contain;"
                             alt="Product Image"/>
                        <br></br>

                        <b>Machine Name :</b>
                        <t t-esc="machine.machine_name"/>
                        <br></br>

                        <b>Serial Number :</b>
                        <t t-esc="machine.serial_number"/>
                        <br></br>

                        <b>Purchase Value :</b>
                        <t t-esc="machine.purchase_value"/>
                        <br></br>

                        <b>Date of Purchase :</b>
                        <t t-esc="machine.date_of_purchase"/>
                        <br></br>

                        <b>Description :</b>
                        <t t-esc="machine.description"/>

                    </div>
                </div>
                <br></br>
                <a class="btn btn-primary"
                   t-att-href="'/web#model=machine.management&amp;id=%s&amp;'%machine.id">
                    View Backend
                </a>
            </center>
        </t>
    </template>

</odoo>