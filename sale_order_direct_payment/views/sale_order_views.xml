<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="sale_order_only_form_view" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.direct.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button string="Direct Payment"
                        type="object"
                        name="action_direct_payment"
                        invisible="state != 'sale'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_payment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bars"
                        invisible="payment_count==0">
                    <field name="payment_count"
                           widget="statinfo"
                           string="Payments"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>