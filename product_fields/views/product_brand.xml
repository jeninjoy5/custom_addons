<?xml version="1.0" encoding="utf-8"?>

<odoo>

<!--VIEWS-->


    <record id="product_brand_view_tree" model="ir.ui.view">
        <field name="name">product.brand.list</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="product_brand_view_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Product Brand Details" class="product_brand_details">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

