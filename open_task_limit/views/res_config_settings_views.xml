<?xml version="1.0" encoding="utf-8"?>


<odoo>

   <record id="res_config_settings_view_form_inherit_project" model="ir.ui.view">
       <field name="name">res.config.settings.view.form.inherit.project</field>
       <field name="model">res.config.settings</field>
       <field name="inherit_id" ref="project.res_config_settings_view_form"/>
       <field name="arch" type="xml">
           <xpath expr="//app[@name='project']" position="inside">
               <block title="Task Limit">
                   <setting string="Limit Task for Users"
                            help="Set maximum number of tasks for users">
                       <field name="is_limit_task"/>
                       <field name="max_tasks" invisible="is_limit_task != True"/>
                   </setting>
               </block>
           </xpath>
       </field>
   </record>

</odoo>