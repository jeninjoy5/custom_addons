<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="action_machine_service" model="ir.actions.act_window">
        <field name="name">Machine Services</field>
        <field name="res_model">machine.service</field>
        <field name="view_mode">list,form</field>
    </record>

        <record id="machine_service_view_tree" model="ir.ui.view">
        <field name="name">machine.service.list</field>
        <field name="model">machine.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="machine_name_id"/>
                <field name="customer_id"/>
                <field name="company_id"/>
                <field name="service_state"
                        decoration-success="service_state == 'done'"
                        decoration-info="service_state == 'open'"
                        decoration-primary="service_state == 'started'"
                        decoration-warning="service_state == 'cancelled'"
                        widget="badge"/>
            </list>
        </field>
    </record>

    <record id="machine_service_view_form" model="ir.ui.view">
        <field name="name">machine.service.form</field>
        <field name="model">machine.service</field>
        <field name="arch" type="xml">
            <form string="Machine Service Details"
                  class="machine_service_details">
                <header>
                    <button string="Start"
                            type="object"
                            name="action_service_start"
                            class="btn-primary"
                            invisible="service_state != 'open'"/>
                    <button string="Close"
                            type="object"
                            name="action_service_close"
                            class="btn-primary"
                            invisible="service_state != 'started'"/>
                    <button string="Create Invoice"
                            type="object"
                            name="action_create_invoice"
                            class="btn-primary"
                            invisible="service_state != 'done' or
                            invoice_status != 'to_invoice'"/>
                    <button string="Cancel"
                            type="object"
                            name="action_cancel_service"/>
                    <field name="service_state" widget="statusbar"
                           statusbar_visible="open,started,done,cancelled"/>
                </header>
                <sheet>
                     <widget name="web_ribbon" title="Archived"
                             bg_color="text-bg-danger"
                             invisible="active"/>
                     <widget name="web_ribbon" title="Draft"
                            bg_color="text-bg-success"
                            invisible="invoice_status != 'invoiced'"/>
                    <widget name="web_ribbon" title="Posted"
                            bg_color="text-bg-success"
                            invisible="invoice_status != 'invoice_posted'"/>
                    <widget name="web_ribbon" title="Paid"
                            bg_color="text-bg-success"
                            invisible="invoice_status != 'paid'"/>
                    <div name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_invoice"
                                icon="fa-pencil-square-o"
                                string="Invoice"
                                invisible="invoice_count == 0">
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="machine_name_id"/>
                            <field name="customer_id"/>
                            <field name="user_ids"
                                   widget="many2many_avatar_user"/>
                            <field name="company_id"/>

                        </group>
                        <group>
                            <field name="service_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="service_order_line_ids">
                                <list string="Parts Order Lines"
                                      editable="bottom">
                                    <field name="parts_id"
                                           placeholder="Search a part"/>
                                    <field name="parts_qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_total" />
                                    <control>
                                        <create name="add_product_control"
                                                string="Add a part"/>
                                    </control>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                        <field name="description"
                               placeholder="Add a description"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_notes"
                                   placeholder="Add internal notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_service_filter" model="ir.ui.view">
        <field name="name">service.select</field>
        <field name="model">machine.service</field>
        <field name="arch" type="xml">
            <search string="Search Services">
                <filter string="Archived"
                        name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>