<?xml version="1.0" encoding="utf-8"?>


<odoo>

    <record id="action_transfer_report" model="ir.actions.act_window">
        <field name="name">Machine Transfers</field>
        <field name="res_model">transfer.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_transfer_report_wizard"/>
    </record>

   <record id="view_transfer_report_wizard" model="ir.ui.view">
       <field name="name">transfer.report</field>
       <field name="model">transfer.report.wizard</field>
       <field name="arch" type="xml">
           <form string="Transfer Report">
               <group>
                   <field name="from_date"/>
                   <field name="to_date"/>
                   <field name="customer_ids" widget="many2many_avatar_user"/>
                   <field name="transfer_type"/>
                   <field name="machine_ids" widget="many2many_avatar_user"/>
               </group>
               <footer>
                   <button string="PDF"
                           type="object"
                           class="btn-primary"
                           name="action_report_machine_transfer"/>
                   <button string="XLSX"
                           type="object"
                           class="btn-primary"
                           name="action_xlsx_report_machine_transfer"/>
                   <button string="Cancel"
                           class="btn-secondary"
                           special="cancel"/>
               </footer>
           </form>
       </field>
   </record>

</odoo>