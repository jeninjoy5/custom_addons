<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="action_machine_transfer" model="ir.actions.act_window">
        <field name="name">Machine Transfers</field>
        <field name="res_model">machine.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--VIEWS-->

    <record id="machine_transfer_view_tree" model="ir.ui.view">
        <field name="name">machine.transfer.list</field>
        <field name="model">machine.transfer</field>
        <field name="arch" type="xml">
            <list string="Machine Transfer Details"
                  decoration-success="transfer_state == 'done'"
                  decoration-info="transfer_state == 'draft'">
                <field name="machine_name_id"/>
                <field name="customer_id"/>
                <field name="company_id"/>
                <field name="transfer_type"/>
            </list>
        </field>
    </record>

    <record id="machine_transfer_view_form" model="ir.ui.view">
        <field name="name">machine.transfer.form</field>
        <field name="model">machine.transfer</field>
        <field name="arch" type="xml">
            <form string="Machine Transfer Details"
                  class="machine_transfer_details">
                <header>
                    <button string="Transfer"
                            type="object"
                            name="action_machine_form_view"
                            class="oe_highlight"/>
<!--                    <button string="Print"-->
<!--                            type="object"-->
<!--                            name="action_sale_order_view"/>-->
                    <field name="transfer_state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Transferred"
                            bg_color="text-bg-success"
                            invisible="transfer_state != 'done'"/>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="transfer_type"/>
                            <field name="machine_name_id"/>
                            <field name="serial_number"/>
                            <field name="transfer_date"/>
                            <field name="company_id"/>
                            <field name="customer_id" />
<!--                                   invisible="transfer_type not in ('install')"-->

<!--                            <field name="sale_order_id"/>-->
<!--                            <field name="dob"/>-->
<!--                            <field name="age"/>-->

                        </group>
                        <notebook>
                            <page string="Internal Notes">
                                <field name="internal_notes"
                                       placeholder="Add Internal Notes"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_transfer_filter" model="ir.ui.view">
        <field name="name">transfer.select</field>
        <field name="model">machine.transfer</field>
        <field name="arch" type="xml">
            <search string="Search Transfers">
                <filter string="Archived"
                        name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>