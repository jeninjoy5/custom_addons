<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="web_form_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level ">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-7 mt-4 mt-lg-0">
                                <section class="">
                                    <div class="container">
                                        <form action="/webform/submit"
                                              class="o_mark_required"
                                              method="post">
                                            <input type="hidden"
                                                   name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>
                                            <br></br>
                                            <h2>Machine Service Request</h2>
                                            <br></br>
                                            <div class="row">
                                                <label class="col-form-label col-sm-auto"
                                                       style="width: 200px;"
                                                       for="customer">
                                                    Machine
                                                    <span class="text-danger">
                                                        *
                                                    </span>
                                                </label>
                                                <select name="machine"
                                                        class="form-select country_id">
                                                    <option>Select Machine</option>
                                                    <t t-foreach="machines"
                                                       t-as="machine">
                                                        <option t-att-value="machine.id">
                                                            <t t-out="machine.machine_name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <label class="col-form-label col-sm-auto"
                                                       style="width: 200px;"
                                                       for="customer">
                                                    <br></br>Customer
                                                    <span class="text-danger">
                                                        *
                                                    </span>
                                                </label>
                                                <select name="customer"
                                                        class="form-select country_id">
                                                    <option>Select Customer</option>
                                                    <t t-foreach="customers"
                                                       t-as="customer">
                                                        <option t-att-value="customer.id">
                                                            <t t-out="customer.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <div class="form-group col-12"><br></br>
                                                    <label class="col-form-label col-sm-auto"
                                                           style="width: 200px;"
                                                           for="date">
                                                        Date
                                                        <span class="text-danger">
                                                            *
                                                        </span>
                                                    </label>
                                                    <div class="col-sm">
                                                        <input id="date"
                                                               type="date"
                                                               class="form-control"
                                                               name="date"
                                                               style="width: 700px;"
                                                               required="1"/>
                                                    </div>
                                                </div>
                                                <div class="form-group col-12"><br></br>
                                                    <label class="col-form-label col-sm-auto"
                                                           style="width: 200px;"
                                                           for="description">
                                                        Description
                                                    </label>
                                                    <textarea id="description_service" class="form-control s_website_form_input" name="description" rows="8"></textarea>
                                                </div>
                                                <div class="form-group col-12">
                                                    <div style="width: 200px;"></div>
                                                    <br></br><button type="submit"
                                                            class="btn btn-primary">
                                                        Submit
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                                <h5>My Company</h5>
                                <ul class="list-unstyled mb-0 ps-2">
                                    <li>
                                        <i class="fa fa-map-marker fa-fw me-2"/>
                                        <span class="o_force_ltr">3575 Fake
                                            Buena Vista Avenue
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa fa-phone fa-fw me-2"/>
                                        <span class="o_force_ltr">+1
                                            555-555-5556
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa fa-1x fa-fw fa-envelope me-2"/>
                                        <span>info@yourcompany.example.com
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>


    <template id="web_form_success">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level ">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-7 mt-4 mt-lg-0">
                                <section class="">
                                    <div class="container">
                                        <br></br>
                                        <br></br>
                                        <h2>Your Machine Service Request</h2>
                                        <h2>has been successfully submitted</h2>
                                    </div>
                                </section>
                            </div>
                            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                                <h5>My Company</h5>
                                <ul class="list-unstyled mb-0 ps-2">
                                    <li>
                                        <i class="fa fa-map-marker fa-fw me-2"/>
                                        <span class="o_force_ltr">3575 Fake
                                            Buena Vista Avenue
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa fa-phone fa-fw me-2"/>
                                        <span class="o_force_ltr">+1
                                            555-555-5556
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa fa-1x fa-fw fa-envelope me-2"/>
                                        <span>info@yourcompany.example.com
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>


    <template id="web_form_customer">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level ">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-7 mt-4 mt-lg-0">
                                <section class="">
                                    <div class="container">
                                        <form action="/webform/customer"
                                              class="o_mark_required"
                                              method="post">
                                            <input type="hidden"
                                                   name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>
                                        <br></br>
                                        <br></br>
                                        <h1>Create New Customer</h1>
                                            <div class="form-group col-12">
                                                <br></br>
                                                <label class="col-form-label col-sm-auto"
                                                       style="width: 200px;"
                                                       for="name">
                                                    Name
                                                    <span class="text-danger">
                                                        *
                                                    </span>
                                                </label>
                                                <div class="col-sm">
                                                    <input id="name"
                                                           type="text"
                                                           class="form-control"
                                                           name="name"
                                                           style="width: 700px;"
                                                           required="1"/>
                                                </div>
                                                <div class="form-group col-12">
                                                    <div style="width: 200px;"></div>
                                                    <br></br><button type="submit"
                                                            class="btn btn-primary">
                                                        Create
                                                    </button>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                                <h5>My Company</h5>
                                <ul class="list-unstyled mb-0 ps-2">
                                    <li>
                                        <i class="fa fa-map-marker fa-fw me-2"/>
                                        <span class="o_force_ltr">
                                            3575 Fake
                                            Buena Vista
                                            Avenue
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa fa-phone fa-fw me-2"/>
                                        <span class="o_force_ltr">
                                            +1
                                            555-555-5556
                                        </span>
                                    </li>
                                    <li>
                                        <i class="fa fa-1x fa-fw fa-envelope me-2"/>
                                        <span>
                                            info@yourcompany.example.com
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>


