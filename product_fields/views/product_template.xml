<?xml version="1.0" encoding="utf-8"?>


<odoo>

    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="product_brand"/>
<!--                       invisible="product_master_type != 'branded'"/>-->
                <field name="product_master_type"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_tree_view" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="product_brand"/>
            </xpath>
        </field>
    </record>

</odoo>