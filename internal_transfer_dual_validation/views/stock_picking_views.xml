<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="stock_picking_approve_transfer" model="ir.ui.view">
            <field name="name">stock.picking.approve.transfer</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="priority" eval="3"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_validate']"
                       position="attributes">
                    <attribute name="invisible">state in ['draft', 'confirmed',
                        'done', 'cancel','to_approve']</attribute>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="after">
                    <button string="Approve"
                            type="object"
                            class="oe_highlight"
                            name="action_approve_transfer"
                            groups='stock.group_stock_manager'
                            invisible="state != 'to_approve'"/>
                </xpath>
            </field>
    </record>

</odoo>
