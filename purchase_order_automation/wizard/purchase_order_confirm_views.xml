<odoo>

   <record id="view_purchase_order_confirm_wizard" model="ir.ui.view">
       <field name="name">purchase.order.confirm.form</field>
       <field name="model">purchase.order.confirm</field>
       <field name="arch" type="xml">
           <form string="Confirm Purchase">
               <group>
                   <field name="product_id"/>
                   <field name="quantity"/>
                   <field name="price"/>
               </group>
               <footer>
                   <button string="Confirm"
                           type="object"
                           class="btn-primary"
                           name="action_confirm_purchase_order"/>
                   <button string="Cancel" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>

</odoo>